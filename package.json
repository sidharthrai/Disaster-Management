{
  "name": "community-help-network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=1000 next dev --webpack --hostname 127.0.0.1",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "test:e2e": "node scripts/demo-check.mjs && node scripts/operations-check.mjs",
    "account:role": "node scripts/account-role.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "check:operations": "node scripts/operations-check.mjs",
    "check:accounts": "node scripts/accounts-check.mjs",
    "check:community": "node scripts/community-check.mjs",
    "recovery:outbox": "node scripts/recovery-outbox.mjs",
    "check:recovery": "node scripts/recovery-check.mjs",
    "check:local-workflows": "node scripts/local-workflows-check.mjs",
    "check:remaining": "node scripts/remaining-features-check.mjs",
    "check:live-ai": "tsx scripts/live-ai-check.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "1.7.21",
    "better-sqlite3": "^12.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.0.0",
    "leaflet": "^1.9.4",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
