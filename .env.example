# Optional intake provider. Omit or use "fallback" for deterministic local extraction.
AI_PROVIDER=fallback

# Ollama must already be running. The app does not download models.
# AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Also verified locally with the already-installed ministral-3:3b model.

# Optional server-only OpenAI-compatible hosted adapter.
# AI_PROVIDER=hosted
# HOSTED_AI_API_KEY=
# HOSTED_AI_BASE_URL=https://api.openai.com/v1
# HOSTED_AI_MODEL=gpt-4.1-mini

# Optional server-only settings.
# AI_TIMEOUT_MS=15000
# DEMO_SESSION_SECRET=replace-for-local-session-signing
# DATABASE_PATH=data/community.sqlite

# Account mode uses separate durable SQLite files; omit APP_MODE for keyless demo.
# APP_MODE=accounts
# APP_BASE_URL=https://your-domain.example
# BETTER_AUTH_SECRET=generate-a-stable-random-secret-at-least-32-characters
# AUTH_DATABASE_PATH=data/accounts-auth.sqlite
# DATABASE_PATH=data/accounts-community.sqlite

# Automatic follow-up requires a persistent running Node server (1–60 minutes).
# FOLLOW_UP_INTERVAL_MINUTES=1
# Local account recovery writes private reset links here; loopback origins only.
# RECOVERY_OUTBOX_PATH=data/recovery-outbox.jsonl
